import tkinter as tk
from tkinter import scrolledtext
from collections import deque
import time


# =========================
# Parser 함수
# =========================
def markdown_parser():

    process_box.delete("1.0", tk.END)
    output.delete("1.0", tk.END)
    stack_view.delete("1.0", tk.END)

    text = entry.get("1.0", tk.END)

    q = deque(text)

    stack = []

    result = ""

    process_box.insert(tk.END, "🌸 Markdown Parsing Start...\n\n")

    while q:

        ch = q.popleft()

        process_box.insert(
            tk.END,
            f"📥 Queue : {ch}\n"
        )


        # =========================
        # 1순위 : ***
        # =========================
        if ch == "*" and len(q) >= 2 and q[0] == "*" and q[1] == "*":

            q.popleft()
            q.popleft()

            if not stack or stack[-1] != "bolditalic":

                stack.append("bolditalic")

                result += "<b><i>"

                process_box.insert(
                    tk.END,
                    "🟣 PUSH : bold + italic\n"
                )

            else:

                stack.pop()

                result += "</i></b>"

                process_box.insert(
                    tk.END,
                    "🟣 POP : bold + italic\n"
                )


        # =========================
        # 2순위 : **
        # =========================
        elif ch == "*" and q and q[0] == "*":

            q.popleft()

            if not stack or stack[-1] != "bold":

                stack.append("bold")

                result += "<b>"

                process_box.insert(
                    tk.END,
                    "🩷 PUSH : bold\n"
                )

            else:

                stack.pop()

                result += "</b>"

                process_box.insert(
                    tk.END,
                    "🩷 POP : bold\n"
                )


        # =========================
        # 3순위 : *
        # =========================
        elif ch == "*":

            if not stack or stack[-1] != "italic":

                stack.append("italic")

                result += "<i>"

                process_box.insert(
                    tk.END,
                    "🩵 PUSH : italic\n"
                )

            else:

                stack.pop()

                result += "</i>"

                process_box.insert(
                    tk.END,
                    "🩵 POP : italic\n"
                )


        # 제목
        elif ch == "#":

            title = ""

            while q and q[0] != "\n":
                title += q.popleft()

            result += f"<h1>{title.strip()}</h1>\n"

            process_box.insert(
                tk.END,
                "💜 제목 변환 완료\n"
            )


        else:
            result += ch


        # Stack 상태 표시
        stack_view.delete("1.0", tk.END)

        stack_view.insert(
            tk.END,
            "🌼 현재 Stack 상태\n\n"
        )

        for item in reversed(stack):

            stack_view.insert(
                tk.END,
                f"☁️ {item}\n"
            )


        process_box.see(tk.END)

        window.update()

        time.sleep(0.15)


    process_box.insert(
        tk.END,
        "\n✅ Parsing Complete!"
    )

    output.insert(tk.END, result)


